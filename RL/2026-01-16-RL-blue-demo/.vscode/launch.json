    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "--model_name Qwen/Qwen3-0.6B  --prompts_file prompts.txt --target_word blue --epochs 2 --batch_size 2"
        }
    ]
}